            "maxLength": 180,
            "minLength": 1,
            "title": "Pickuplocation"
          },
          "description": {
            "type": "string",
            "maxLength": 1500,
            "title": "Description",
            "default": ""
          },
          "imageUrl": {
            "type": "string",
            "maxLength": 1000,
            "title": "Imageurl",
            "default": ""
          },
          "isPublished": {
            "type": "boolean",
            "title": "Ispublished",
            "default": true
          },
