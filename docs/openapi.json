            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Cargovolumem3"
          },
          "hourlyPriceRub": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 1.0,
            "title": "Hourlypricerub"
          },
          "dailyPriceRub": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 1.0,
            "title": "Dailypricerub"
          },
